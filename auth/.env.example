# CodeBridge Auth App — environment variables
# Copy to .env and fill in values for local development

# Set to "true" to use MSW mocks instead of the real backend
VITE_USE_MOCKS=true

# API gateway URL (only used when VITE_USE_MOCKS=false)
VITE_GATEWAY_URL=http://localhost:8080

# Dashboard app URL for cross-app navigation
VITE_DASHBOARD_URL=http://localhost:5175

# GitHub integration mode: "mock" (simulated) or "off" (hidden until GitHub service is live)
# Defaults to "mock" when VITE_USE_MOCKS=true, otherwise "off"
VITE_GITHUB_MODE=mock
